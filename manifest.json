{
  "manifest_version": 3,
  "name": "RaaS Dev Navigator",
  "version": "1.0.0",
  "description": "Internal dev tool: quickly open raas-b2b-app routes with the right environment, credentials, and query params pre-filled.",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_title": "RaaS Dev Navigator",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
